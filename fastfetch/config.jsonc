{
  "$schema": "https://github.com",
  "logo": {
    // "type": "small",
    "source": "~/.config/fastfetch/Fed.txt",
    "position": "top",
    "padding": {
      "top": 1,
      "left": 3,
      "right": 3,
      "bottom": 1
    }
  },
  "display": {
    "separator": "",
    "constants": [
      "──────────────" // {$1}, used in Custom module
    ],
    "key": {
      "width": 10
    }
  },
  "modules": [
    {
      "type": "custom", // HardwareStart
      // {#1} is equivalent to `\u001b[1m`. {#} is equivalent to `\u001b[m`
      "format": "{#90}┌{$1} Hardware {$1}{$1}┐{#}"
    },
    {
      "key": "CPU",
      "type": "cpu",
      "showPeCoreCount": true,
      "format": "{name:-32} ({cores-physical}C/{cores-logical}T)",
      "keyColor": "33"
    },
    {
      "key": "GPU",
      "type": "gpu",
      "format": "{2:-30}",
      "keyColor": "32"
    },
    {
      "key": "Display",
      "type": "display",
      "keyColor": "36"
    },
    {
      "key": "Disk",
      "type": "disk",
      "folders": "/",
      "keyColor": "34"
    },
    {
      "key": "Memory",
      "type": "memory",
      "keyColor": "31"
    },
    {
      "key": "Swap",
      "type": "swap",
      "keyColor": "95"
    },
    {
      "type": "custom", // InformationEnd
      "format": "{#90}└{$1}────────────────────────{$1}┘{#}"
    },
    {
      "type": "custom", // SoftwareStart
      // {#1} is equivalent to `\u001b[1m`. {#} is equivalent to `\u001b[m`
      "format": "{#90}┌{$1} Software {$1}{$1}┐{#}"
    },
    {
      "key": "OS",
      "type": "os",
      "format": "{3:-35}",
      "keyColor": "33"
    },
    {
      "key": "Kernel",
      "type": "kernel",
      "format": "{2}",
      "keyColor": "93"
    },
    {
      "key": "DM",
      "type": "lm",
      "keyColor": "35"
    },
    {
      "key": "DE",
      "type": "de",
      "keyColor": "91"
    },
    {
      "key": "WM",
      "type": "wm",
      "keyColor": "32"
    },
    {
      "key": "Theme",
      "type": "theme",
      "format": "{1:-35}",
      "keyColor": "92"
    },
    {
      "key": "Icons",
      "type": "icons",
      "format": "{1:-35}",
      "keyColor": "36"
    },
    {
      "key": "Font",
      "type": "font",
      "format": "{1:-35}",
      "keyColor": "96"
    },
    {
      "key": "Font",
      "type": "terminalfont",
      "format": "{1:-35}",
      "keyColor": "34"
    },
    {
      "key": "Terminal",
      "type": "terminal",
      "keyColor": "94"
    },
    {
      "key": "Shell",
      "type": "shell",
      "keyColor": "34"
    },
    {
      "type": "custom", // InformationEnd
      "format": "{#90}└{$1}────────────────────────{$1}┘{#}"
    }
  ]
}
